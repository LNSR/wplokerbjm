/*
Theme Name: Astra Child
Theme URI: https://wpastra.com/
Template: astra
Version: 4.8.11
*/
@import 'tailwindcss/theme.css' layer(theme);
@import 'tailwindcss/preflight.css' layer(base);
@import 'tailwindcss/utilities.css' layer(utilities);
/* -----------------------------
   1. Base & Layout
----------------------------- */
@layer base {
  .job-listing-single {
    @apply max-w-[1000px] mx-auto my-8 p-8 bg-white shadow-md rounded-xl;
  }

  .section {
    @apply py-10 first:pt-4 last:pb-4;
  }
}

/* -----------------------------
   2. Typography & Headings
----------------------------- */
@layer components {
  /* Typography & Headings */
  .job-title {
    @apply text-4xl mb-0 text-center;
  }

  .company-name {
    @apply text-4xl font-semibold leading-relaxed;
  }

  .section h3 {
    @apply text-2xl text-gray-800 mb-8 flex items-center gap-3;
  }

  /* Company Section */
  .company-info {
    @apply flex items-center gap-4 mb-4;
  }

  .company-description {
    @apply my-0;
  }

  .company-description h3 {
    @apply mb-6;  /* Add specific margin for company description heading */
  }

  /* Content Typography */
  .company-description p,
  .section p,
  .requirements p {
    @apply text-justify leading-relaxed text-gray-600 mb-4 last:mb-0;
  }

  /* Summary Grid */
  .summary-grid {
    @apply grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] gap-6 my-4;
  }

  .summary-item {
    @apply flex items-start p-4 bg-gray-50 rounded-xl border border-gray-200 
           transition-all duration-300 hover:translate-y-[-3px] hover:shadow-lg hover:bg-white;
  }

  .summary-icon {
    @apply flex items-center justify-center w-[45px] h-[45px] bg-gray-100 
           rounded-xl mr-4;
  }

  .summary-icon i {
    @apply text-xl text-blue-600;
  }

  .summary-content {
    @apply flex-1;
  }

  .summary-label {
    @apply block text-sm font-medium text-gray-500 mb-2 uppercase tracking-wider;
  }

  .summary-value {
    @apply block text-lg font-semibold text-gray-800 leading-relaxed;
  }

  /* Section Divider */
  .section-divider {
    @apply relative h-px my-10 bg-gradient-to-r from-transparent via-gray-200 to-transparent;
  }

  .section-divider::before {
    @apply content-[''] absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 
           w-1.5 h-1.5 bg-gray-300 rounded-full;
  }

  /* Contact Section */
  .contact-list {
    @apply list-none p-0 mb-8 space-y-4;
  }

  .contact-list li {
    @apply flex items-center mb-2 py-1;
  }

  .contact-list li i,
  .contact-list a {
    @apply text-blue-600;
  }

  .contact-list li i {
    @apply mr-2;
  }

  .contact-list a {
    @apply no-underline hover:underline;
  }

  /* Social Media */
  .social-media {
    @apply flex flex-wrap gap-6 items-center;
  }

  .social-icon {
    @apply flex items-center text-blue-600 no-underline mr-2.5 hover:underline;
  }

  .social-icon i {
    @apply mr-2;
  }

  /* Social Media Section */
  .social-heading {
    @apply text-2xl text-gray-800 mb-6 mt-10 flex items-center gap-3;
  }

  .social-media-container {
    @apply bg-gray-50 p-8 rounded-xl border border-gray-200;
  }

  .social-media {
    @apply flex flex-wrap gap-6 items-center;
  }

  .social-icon {
    @apply flex items-center px-4 py-2 bg-white rounded-lg border border-gray-200 
           text-blue-600 no-underline transition-all duration-300
           hover:bg-blue-50 hover:border-blue-200 hover:translate-y-[-2px];
  }

  .social-icon i {
    @apply mr-3 text-lg;
  }

  /* Job Header */
  .job-header {
    @apply mb-6;
  }
  
  /* Company Section - Rename for better semantics */
  .company-section {
    @apply mb-6;
  }

  /* Job Details Section */
  .job-details {
    @apply space-y-8;
  }

  /* Contact Section Improvements */
  .contact-section {
    @apply mt-16 mb-10 pt-6;
  }

  .contact-section h3 {
    @apply text-2xl text-gray-800 mb-8 pb-2 border-b border-gray-100;
  }

  .contact-list {
    @apply list-none p-0 mb-12 space-y-5;
  }

  .contact-list li {
    @apply flex items-center py-2 px-1 hover:bg-gray-50 rounded-lg transition-colors duration-200;
  }

  .contact-list li i {
    @apply mr-4 text-lg text-blue-600;
  }

  .contact-list a {
    @apply text-lg text-gray-700 hover:text-blue-600 transition-colors duration-200;
  }

  /* Formatted Content */
  .formatted-content {
    @apply space-y-4 mt-4;  /* Adds consistent vertical spacing between paragraphs */
  }

  .formatted-content p {
    @apply text-gray-600 leading-relaxed text-justify mb-0;  /* Remove bottom margin since we use space-y */
  }

  .formatted-content p:first-of-type {
    @apply indent-8;  /* Add indentation to first paragraph */
  }

  .formatted-content ul,
  .formatted-content ol {
    @apply pl-6 space-y-2;  /* Style lists within formatted content */
  }
}

/* -----------------------------
   9. Responsive Design
----------------------------- */
@layer utilities {
  @media (max-width: 768px) {
    .job-listing-single {
      @apply mx-2 my-4 p-4;
    }

    .company-info {
      @apply gap-2;
    }

    .summary-grid {
      @apply grid-cols-1 gap-4;
    }

    .job-meta {
      @apply flex-col gap-3;
    }

    .job-meta span {
      @apply w-full;
    }
  }
}
