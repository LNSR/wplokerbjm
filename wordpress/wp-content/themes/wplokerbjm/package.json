{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "wplokerbjm-sveltekit",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "bun:config": "bun --use-system-ca --env-file=.env",
    "dev": "bun run bun:config --bun vite dev --host > vite.dev.log 2>&1",
    "build": "bun run bun:config --bun vite build > vite.build.log 2>&1",
    "preview": "bun run bun:config wrangler dev -c wrangler.dev.toml > vite.preview.log 2>&1",
    "prepare": "ts-patch install && bun run bun:config svelte-kit sync || echo ''",
    "check": "bun run bun:config --bun --parallel \"svelte-check-rs --tsconfig ./tsconfig.json\" \"tsgo\"",
    "check:watch": "bun run bun:config --bun --parallel \"svelte-check-rs --tsconfig ./tsconfig.json --watch\"",
    "generate-types": "bun run bun:config --bun --parallel \"wrangler types\" \"gql-tada generate-output --output './src/graphql-env.d.ts'\" \"gql-tada generate-schema 'https://localhost/graphql' --output './schema.graphql'\" \"gql-tada generate turbo\""
  },
  "graphql": {
    "schema": "./schema.graphql",
    "documents": "**/*.{graphql,ts,svelte}"
  },
  "dependencies": {
    "@qwik.dev/partytown": "^0.13.2",
    "idb": "^8.0.3",
    "lru-cache": "^11.3.6",
    "swiper": "^12.1.4",
    "urql": "^5.0.2",
    "viewerjs": "^1.11.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260511.1",
    "@eslint/compat": "^2.1.0",
    "@gql.tada/svelte-support": "^1.0.2",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.59.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "4.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/bun": "^1.3.13",
    "@types/node": "^25.7.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typia/unplugin": "^12.1.1",
    "@urql/exchange-persisted": "^5.0.1",
    "daisyui": "^5.5.19",
    "es-toolkit": "^1.46.1",
    "eslint": "^10.3.0",
    "eslint-plugin-svelte": "^3.17.1",
    "globals": "^17.6.0",
    "gql.tada": "^1.9.2",
    "graphql": "^16.14.0",
    "runed": "^0.37.1",
    "svelte": "^5.55.5",
    "svelte-awesome-icons": "^3.0.1",
    "svelte-check": "^4.4.8",
    "svelte-check-rs": "^0.9.8",
    "sveltekit-device-detector": "^2.0.1",
    "tailwindcss": "4.3.0",
    "ts-patch": "^4.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.3",
    "typia": "^12.1.1",
    "vite": "^8.0.12",
    "vite-bundle-analyzer": "^1.3.8",
    "vite-plugin-devtools-json": "^1.0.0",
    "wrangler": "^4.90.1"
  }
}