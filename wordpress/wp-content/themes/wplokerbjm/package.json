    "html-minifier-terser": "^7.2.0",
    "playwright": "^1.57.0",
    "svelte": "^5.46.1",
    "svelte-check": "^4.3.5",
    "svelte-language-server": "^0.17.23",
    "typescript": "~5.9.3",
    "vite": "8.0.0-beta.6",
    "vite-bundle-analyzer": "^1.3.2",
