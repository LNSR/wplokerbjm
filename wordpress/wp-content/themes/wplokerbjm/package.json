{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "wplokerbjm-sveltekit",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "bun:config": "bun --use-system-ca --env-file=.env",
    "dev": "bun run bun:config --bun vite dev --host > vite.dev.log 2>&1",
    "build": "bun run bun:config --bun vite build > vite.build.log 2>&1",
    "preview": "bun run bun:config wrangler dev -c wrangler.dev.toml > vite.preview.log 2>&1",
    "prepare": "ts-patch install && bun run bun:config svelte-kit sync || echo ''",
    "check": "bun run bun:config --bun --parallel \"svelte-check --tsconfig ./tsconfig.json\" \"tsc\"",
    "check:watch": "bun --parallel \"svelte-check --tsconfig ./tsconfig.json --watch\"",
    "generate-types": "bun run bun:config --parallel \"wrangler types\" \"gql-tada generate-output --output './src/graphql-env.d.ts'\" \"gql-tada generate-schema 'https://localhost/graphql' --output './schema.graphql'\" \"gql-tada generate turbo\""
  },
  "graphql": {
    "schema": "./schema.graphql",
    "documents": "**/*.{graphql,ts,svelte}"
  },
  "dependencies": {
    "@qwik.dev/partytown": "^0.13.2",
    "idb": "^8.0.3",
    "lru-cache": "^11.3.3",
    "swiper": "^12.1.3",
    "urql": "^5.0.1",
    "viewerjs": "^1.11.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260410.1",
    "@eslint/compat": "^2.0.5",
    "@gql.tada/svelte-support": "^1.0.2",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.57.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/bun": "^1.3.11",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typia/unplugin": "^12.0.2",
    "@urql/exchange-persisted": "^5.0.1",
    "daisyui": "^5.5.19",
    "es-toolkit": "^1.45.1",
    "eslint": "^10.2.0",
    "eslint-plugin-svelte": "^3.17.0",
    "globals": "^17.4.0",
    "gql.tada": "^1.9.2",
    "graphql": "^16.13.2",
    "svelte": "^5.55.2",
    "svelte-awesome-icons": "^3.0.1",
    "svelte-check": "^4.4.6",
    "sveltekit-device-detector": "^2.0.1",
    "tailwindcss": "^4.2.2",
    "ts-patch": "^3.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.1",
    "typia": "^12.0.2",
    "vite": "^8.0.8",
    "vite-bundle-analyzer": "^1.3.7",
    "vite-plugin-devtools-json": "^1.0.0",
    "wrangler": "^4.81.1"
  }
}