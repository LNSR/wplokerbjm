{
  "name": "wplokerbjm",
  "version": "0.0.0",
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.1.18",
    "@tsconfig/svelte": "^5.0.6",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.1.0",
    "concurrently": "^9.2.1",
    "daisyui": "^5.5.16",
    "eslint": "^9.39.2",
    "eslint-plugin-svelte": "^3.14.0",
    "globals": "^17.3.0",
    "svelte": "^5.49.1",
    "svelte-check": "^4.3.6",
    "svelte-language-server": "^0.17.24",
    "typescript": "~5.9.3",
    "vite": "8.0.0-beta.11",
    "vite-bundle-analyzer": "^1.3.2",
    "svelte-awesome-icons": "^3.0.1",
    "vite-plugin-live-reload": "^3.0.5",
    "typescript-eslint": "^8.54.0"
  },
  "overrides": {
    "vite": "8.0.0-beta.11"
  },
  "private": true,
  "scripts": {
    "dev": "bun -b concurrently \"vite\" \"bun -b run watch:autoload\"",
    "build": "bun -b vite build && find ./assets/dist/ -type f -name \"*.js\" -o -name \"*.css\" | xargs brotli -Z -v -f && (command -v docker > /dev/null 2>&1 && docker restart caddy || true)",
    "check": "bun -b concurrently \"svelte-check --tsconfig ./tsconfig.app.json\" \"tsc -p tsconfig.node.json\" \"eslint . --ext .ts,.svelte --fix\"",
    "watch:autoload": "composer run watch:autoload"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "esbuild"
  ],
  "type": "module",
  "dependencies": {
    "@qwik.dev/partytown": "^0.11.2",
    "idb": "^8.0.3",
    "lodash-es": "^4.17.23",
    "lru-cache": "^11.2.5",
    "swiper": "^12.1.0",
    "urql": "^5.0.1",
    "viewerjs": "^1.11.7"
  }
}
