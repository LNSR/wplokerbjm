  },
  "overrides": {
    "vite": "8.0.0-beta.6"
  },
  "private": true,
  "scripts": {
    "dev": "concurrently \"vite\" \"bun -b run watch:autoload\"",
    "build": "vite build && find ./assets/dist/ -type f -name \"*.js\" -o -name \"*.css\" | xargs brotli -Z -v -f",
    "preview": "vite preview",
    "check": "concurrently \"svelte-check --tsconfig ./tsconfig.app.json\" \"tsc -p tsconfig.node.json\" \"eslint . --ext .ts,.svelte --fix\"",
    "ssg": "bun -b tools/SSG/ssg.ts",
    "ssg:sitemap": "bun -b tools/SSG/ssg-sitemap.ts",
    "watch:autoload": "composer run watch:autoload"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "esbuild"
  ],
  "type": "module",
  "dependencies": {
    "@qwik.dev/partytown": "^0.11.2",
    "idb": "^8.0.3",
    "lodash-es": "^4.17.22",
    "lru-cache": "^11.2.4",
    "swiper": "^12.0.3",
    "viewerjs": "^1.11.7"
