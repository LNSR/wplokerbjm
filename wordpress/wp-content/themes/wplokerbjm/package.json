{
  "name": "wplokerbjm-sveltekit",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "NODE_TLS_REJECT_UNAUTHORIZED=0 bun vite dev --host & composer watch:autoload; wait",
    "build": "bun -b vite build",
    "preview": "bun -b run build && wrangler dev",
    "prepare": "bun -b svelte-kit sync || echo ''",
    "check": "bun -b svelte-kit sync && bun -b svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "bun -b svelte-kit sync && bun -b svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "bun -b eslint .",
    "gen": "wrangler types",
    "deploy": "bun -b run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@qwik.dev/partytown": "^0.11.2",
    "@urql/exchange-persisted": "^5.0.1",
    "idb": "^8.0.3",
    "lodash-es": "^4.17.23",
    "lru-cache": "^11.2.6",
    "svelte-awesome-icons": "^3.0.1",
    "swiper": "^12.1.2",
    "urql": "^5.0.1",
    "viewerjs": "^1.11.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260307.1",
    "@eslint/compat": "^2.0.3",
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.53.4",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.2.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.3.5",
    "daisyui": "^5.5.19",
    "eslint": "^10.0.3",
    "eslint-plugin-svelte": "^3.15.0",
    "globals": "^17.4.0",
    "svelte": "^5.53.7",
    "svelte-check": "^4.4.4",
    "sveltekit-device-detector": "^2.0.1",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.0-beta.16",
    "vite-bundle-analyzer": "^1.3.6",
    "vite-plugin-devtools-json": "^1.0.0",
    "wrangler": "^4.71.0"
  },
  "overrides": {
    "vite": "8.0.0-beta.16"
  }
}
