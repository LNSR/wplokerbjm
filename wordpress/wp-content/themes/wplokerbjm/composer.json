{
  "require": {
    "php-di/php-di": "*"
  },
  "require-dev": {
    "php-parallel-lint/php-console-highlighter": "^1.0",
    "php-parallel-lint/php-parallel-lint": "^1.4",
    "php-stubs/wordpress-stubs": "*"
  },
  "autoload": {
    "classmap": ["server"]
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "watch:autoload": "composer dump-autoload --apcu -a",
    "post-update-cmd": ["composer dump-autoload --apcu -a"],
    "lint:php": "./vendor/bin/parallel-lint --colors --exclude vendor --exclude node_modules -j $(nproc) ."
  }
}
