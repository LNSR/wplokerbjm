{
  "require": {
    "php-di/php-di": "*",
    "php-standard-library/php-standard-library": "^6.2"
  },
  "require-dev": {
    "brain/monkey": "*",
    "php-parallel-lint/php-console-highlighter": "*",
    "php-parallel-lint/php-parallel-lint": "*",
    "phpunit/phpunit": "*",
    "vlucas/phpdotenv": "*"
  },
  "autoload": {
    "classmap": [
      "server"
    ]
  },
  "autoload-dev": {
    "classmap": [
      "tests"
    ]
  },
  "config": {
    "sort-packages": true,
    "process-timeout": 0
  },
  "scripts": {
    "watch:autoload": [
      "./tools/Composer/Scripts/autoloadwatcher.sh"
    ],
    "post-update-cmd": [
      "composer dump-autoload --apcu -a -o"
    ],
    "post-install-cmd": [
      "composer dump-autoload --apcu -a -o"
    ],
    "lint:php": "./tools/Composer/Scripts/lint.sh",
    "test": "./tools/Composer/Scripts/test.sh"
  }
}
