{
  "require": {
    "brick/varexporter": "^0.7.0",
    "monolog/monolog": "^3.13",
    "nette/robot-loader": "^4.1.4",
    "php-di/php-di": "^7.1.1",
    "php-standard-library/php-standard-library": "^6.4.2",
    "spatie/backtrace": "^1.8.2"
  },
  "require-dev": {
    "brain/monkey": "^2.7.0",
    "nikic/php-parser": "^5.9.0",
    "php-parallel-lint/php-console-highlighter": "^1.0.0",
    "php-parallel-lint/php-parallel-lint": "^1.4.0",
    "phpunit/phpunit": "^13.4.8",
    "vlucas/phpdotenv": "^5.8.1"
  },
  "config": {
    "sort-packages": true,
    "process-timeout": 0
  },
  "scripts": {
    "watch:autoload": [
      "php ./tools/Composer/Scripts/generate-meta-hooks.php && ./tools/Composer/Scripts/autoloadwatcher.sh"
    ],
    "post-update-cmd": [
      "composer dump-autoload --apcu -a -o"
    ],
    "post-install-cmd": [
      "composer dump-autoload --apcu -a -o"
    ],
    "generate-meta-hooks": "php ./tools/Composer/Scripts/generate-meta-hooks.php",
    "lint:php": "./tools/Composer/Scripts/lint.sh",
    "test": "./tools/Composer/Scripts/test.sh"
  }
}