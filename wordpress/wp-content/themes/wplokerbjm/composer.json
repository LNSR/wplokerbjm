{
  "require": {
    "nette/robot-loader": "*",
    "php-di/php-di": "*",
    "php-standard-library/php-standard-library": "*"
  },
  "require-dev": {
    "brain/monkey": "*",
    "nikic/php-parser": "*",
    "php-parallel-lint/php-console-highlighter": "*",
    "php-parallel-lint/php-parallel-lint": "*",
    "phpunit/phpunit": "*",
    "vlucas/phpdotenv": "*"
  },
  "config": {
    "sort-packages": true,
    "process-timeout": 0
  },
  "scripts": {
    "watch:autoload": [
      "php ./tools/Composer/Scripts/generate-meta-hooks.php & ./tools/Composer/Scripts/autoloadwatcher.sh"
    ],
    "post-update-cmd": [
      "composer dump-autoload --apcu -a -o"
    ],
    "post-install-cmd": [
      "composer dump-autoload --apcu -a -o"
    ],
    "generate-meta-hooks": "php ./tools/Composer/Scripts/generate-meta-hooks.php",
    "lint:php": "./tools/Composer/Scripts/lint.sh",
    "test": "./tools/Composer/Scripts/test.sh"
  }
}
