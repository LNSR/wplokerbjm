# SSG Environment Variables
# This file will be automatically loaded by Vite
# Copy to .env and modify as needed

# ====================================================================
# CORE SSG SETTINGS
# ====================================================================

# Number of concurrent page generations (1-20)
# Higher values = faster generation but more resource usage
# Recommended: 3-5 for most sites, 8-10 for powerful servers
SSG_CONCURRENCY=5

# Maximum retry attempts for failed pages (0-10)
# Higher values = better reliability but slower failure recovery
SSG_MAX_RETRIES=3

# Timeout for individual page generation in milliseconds (10000-120000)
# Higher values = better support for slow pages but longer wait times
SSG_PAGE_TIMEOUT=30000

# Continue processing even if some pages fail (true/false)
# true = complete generation despite errors, false = stop on first error
SSG_CONTINUE_ON_ERROR=true

# Minify HTML output to reduce file size (true/false)
# true = smaller files but longer generation time
SSG_MINIFY_HTML=true

# ====================================================================
# ADBLOCK SETTINGS (NEW)
# ====================================================================

# Block ads during static site generation (true/false)
# RECOMMENDED: true - prevents AdSense policy violations
# Blocks: GoogleAds, AdSense, DoubleClick, Amazon Ads, etc.
SSG_BLOCK_ADS=true

# Block tracking scripts during generation (true/false) 
# RECOMMENDED: true - prevents tracking during generation
# Blocks: Facebook Pixel, Hotjar, FullStory, etc.
SSG_BLOCK_TRACKING=true

# Block analytics during generation (true/false)
# RECOMMENDED: false - keep analytics for site understanding
# Blocks: Google Analytics, GTM (may affect site functionality)
SSG_BLOCK_ANALYTICS=false

# Log blocked requests for debugging (true/false)
# true = detailed blocking logs, false = silent blocking
SSG_LOG_BLOCKED=true

# Comma-separated list of domains to always allow (optional)
# Use this to whitelist specific domains that should never be blocked
# SSG_ALLOWED_DOMAINS=your-cdn.com,trusted-analytics.com

# Comma-separated list of custom URLs/patterns to block (optional)
# Use this to block additional requests beyond the built-in lists
# SSG_CUSTOM_BLOCKLIST=unwanted-tracker.com,annoying-popup.js

# DNS over HTTPS server for enhanced privacy and ad blocking (optional)
# RECOMMENDED: https://dns.adguard.com/dns-query - blocks ads/malware/tracking
# Alternative: https://p2.freedns.controld.com/freedns-query (family protection)
# Leave empty to disable DoH
SSG_DOH_SERVER=https://dns.adguard.com/dns-query

# ====================================================================
# WORDPRESS INTEGRATION SETTINGS
# ====================================================================

# Enable automatic SSG triggers from WordPress (true/false)
# When enabled, post updates will automatically trigger GitHub Actions
SSG_TRIGGER_ENABLED=true

# GitHub repository settings for API calls
# These are typically set in wp-config.php, not .env
# SSG_GITHUB_TOKEN=ghp_your_github_token_here
# SSG_GITHUB_OWNER=your-username
# SSG_GITHUB_REPO=your-repo-name
# SSG_GITHUB_WORKFLOW=ssg.yml
# SSG_GITHUB_REF=main

# ====================================================================
# ADVANCED SETTINGS
# ====================================================================

# Custom User Agent for SSG requests (optional)
# SSG_USER_AGENT=Mozilla/5.0 (compatible; SSG-Bot/1.0)

# Enable HTTPS certificate ignoring for development (true/false)
# Only use for development/testing with self-signed certificates
# SSG_IGNORE_HTTPS_ERRORS=true

# ====================================================================
# PRESET CONFIGURATIONS
# ====================================================================

# Development (safe, slower)
# SSG_CONCURRENCY=2
# SSG_MINIFY_HTML=false
# SSG_CONTINUE_ON_ERROR=false

# Production (fast, optimized)
# SSG_CONCURRENCY=8
# SSG_MINIFY_HTML=true
# SSG_CONTINUE_ON_ERROR=true

# CI/CD (balanced)
# SSG_CONCURRENCY=3
# SSG_MINIFY_HTML=true
# SSG_CONTINUE_ON_ERROR=true

# Memory Constrained (low usage)
# SSG_CONCURRENCY=2
# SSG_MINIFY_HTML=false
# SSG_CONTINUE_ON_ERROR=false