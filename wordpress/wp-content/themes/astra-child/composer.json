{
  "require": {
    "php-di/php-di": "*"
  },
  "require-dev": {
    "php-parallel-lint/php-console-highlighter": "^1.0",
    "php-parallel-lint/php-parallel-lint": "^1.4",
    "php-stubs/wordpress-stubs": "*"
  },
  "autoload": {
    "psr-4": {
      "AstraChild\\": "./inc"
    }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "lint:php": "./vendor/bin/parallel-lint --colors --exclude vendor --exclude node_modules -j $(nproc) .",
    "post-install-cmd": "@lint:php"
  }
}
