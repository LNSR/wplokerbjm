# SSG Environment Variables
# This file will be automatically loaded by Vite
# Copy to .env and modify as needed

# ===========================================
# SSG CONCURRENCY SETTINGS
# ===========================================

# Number of concurrent page generations
# Higher = faster but more memory/CPU usage
SSG_CONCURRENCY=5

# ===========================================
# SSG TIMEOUT SETTINGS
# ===========================================

# Page generation timeout in milliseconds
SSG_PAGE_TIMEOUT=30000

# Maximum retry attempts for failed pages
SSG_MAX_RETRIES=3

# ===========================================
# SSG OUTPUT SETTINGS
# ===========================================

# Enable HTML minification to reduce file size
SSG_MINIFY_HTML=true

# ===========================================
# SSG ERROR HANDLING
# ===========================================

# Continue processing even if some pages fail
SSG_CONTINUE_ON_ERROR=true

# ===========================================
# PRESET CONFIGURATIONS
# ===========================================

# Development (safe, slower)
# SSG_CONCURRENCY=2
# SSG_MINIFY_HTML=false
# SSG_CONTINUE_ON_ERROR=false

# Production (fast, optimized)
# SSG_CONCURRENCY=8
# SSG_MINIFY_HTML=true
# SSG_CONTINUE_ON_ERROR=true

# CI/CD (balanced)
# SSG_CONCURRENCY=3
# SSG_MINIFY_HTML=true
# SSG_CONTINUE_ON_ERROR=true

# Memory Constrained (low usage)
# SSG_CONCURRENCY=2
# SSG_MINIFY_HTML=false
# SSG_CONTINUE_ON_ERROR=false