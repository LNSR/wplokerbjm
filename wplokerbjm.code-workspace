{
  "folders": [
    {
      "name": "wplokerbjm-root",
      "path": ".",
    },
    {
      "name": "wplokerbjm-frontend",
      "path": "sveltekit",
    },
    {
      "name": "wplokerbjm-backend",
      "path": "wordpress/wp-content/themes/wplokerbjm",
    },
    {
      "name": "wplokerbjm-post-automation",
      "path": "wplokerbjm-post-automation",
    },
  ],
  "settings": {
    "php.version": "8.5",
    "php.format.rules.addCommaAfterLastArrayElement": true,
    "editor.codeLens": true,

    // GLOBAL FILE WATCHER EXCLUSIONS
    "files.watcherExclude": {
      "**/dist/**": true,
      "**/build/**": true,
      "**/uploads/**": true,
      "**/cache/**": true,
      "**/.svelte-kit/**": true,
      "**/.git/**": true,
      "**/node_modules/**": true,
      "**/vendor/**": true,
      "**/.wrangler/**": true,
      "**/wordpress/wp-admin/**": true,
      "**/wordpress/wp-includes/**": true
    },

    // DEVSENSE INDEXER CONFIG
    "php.stubs": ["*", "wordpress"],
    "php.workspace.includePath": "wordpress/",
    "php.problems.scope": "opened",
    "php.inlayHints.parameters.enabled": true,
    "php.suggest.basic": false, // Handled by Intelephense
    "php.files.exclude": {
      "**/node_modules/**": true,
      "**/vendor/**": true,
      "**/sveltekit/**": true,
      "**/wplokerbjm-post-automation/**": true,
      "**/wordpress/wp-admin/**": true,
      "**/wordpress/wp-includes/**": true
    },
    "php.problems.exclude": {
      "**/generate-meta-hooks/captures/": true,
      "**/vendor/": true
    },
    "[php]": {
      "editor.defaultFormatter": "DEVSENSE.phptools-vscode"
    },

    // INTELEPHENSE INDEXER CONFIG
    "intelephense.environment.documentRoot": "wordpress/",
    "intelephense.maxMemory": 8196,
    "intelephense.diagnostics.memberAccess": false,
    "intelephense.diagnostics.enable": false, // Leave diagnostics to Devsense to prevent conflicts
    "intelephense.diagnostics.argumentCount": "on",
    "intelephense.codeLens.implementations.enable": false, // Disable to prevent duplicate CodeLens with Devsense
    "intelephense.codeLens.parent.enable": false,
    "intelephense.codeLens.references.enable": false,
    "intelephense.codeLens.usages.enable": false,
    "intelephense.files.maxSize": 1000000,
    "intelephense.files.exclude": [
      "**/.git/**",
      "**/node_modules/**",
      "**/vendor/**",
      "**/sveltekit/**",
      "**/wplokerbjm-post-automation/**",
      "**/wordpress/wp-admin/**",
      "**/wordpress/wp-includes/**"
    ],

    // Svelte & JS/TS Configs
    "[svelte]": {
      "editor.defaultFormatter": "svelte.svelte-vscode"
    },
    "files.associations": {
      "*.css": "tailwindcss"
    },
    "editor.quickSuggestions": {
      "other": "on",
      "comments": "on",
      "strings": "on"
    },
    "eslint.options": {
      "overrideConfigFile": "eslint.config.ts"
    },
    "eslint.workingDirectories": ["${workspaceFolder:wplokerbjm-frontend}"],
    "typescript.enablePromptUseWorkspaceTsdk": true,
    "typescript.tsdk": "wplokerbjm-frontend/node_modules/typescript/lib",
    "graphql-config.load.rootDir": "sveltekit",
    "js/ts.implicitProjectConfig.target": "ESNext",
    
    // Formatting & Font
    "editor.formatOnSave": false,
    "html.format.templating": true,
    "editor.fontFamily": "'Cascadia Code NF'",
    "editor.fontSize": 14,
    "debug.console.fontSize": 12,
    "scm.inputFontSize": 12,
    "terminal.integrated.fontSize": 13,

    // Python Configs
    "python.analysis.enableParallelIndexing": true,
    "python.analysis.inlayHints.functionReturnTypes": true,
    "python.analysis.inlayHints.pytestParameters": true,
    "python.analysis.inlayHints.variableTypes": true,
    "python.analysis.referencesCodeLens": true,
    "python.analysis.typeEvaluation.enableReachabilityAnalysis": true,
    "python.analysis.typeEvaluation.strictDictionaryInference": true,
    "python.analysis.typeEvaluation.strictListInference": true,
    "python.analysis.typeEvaluation.strictSetInference": true
  },
  "extensions": {
    "recommendations": [
      "DEVSENSE.phptools-vscode",
      "bradlc.vscode-tailwindcss",
      "matthewpi.caddyfile-support",
      "aaron-bond.better-comments",
      "dbaeumer.vscode-eslint",
      "devsense.composer-php-vscode",
      "docker.docker",
      "ms-azuretools.vscode-docker",
      "esbenp.prettier-vscode",
      "ms-vscode.vscode-typescript-next",
      "svelte.svelte-vscode",
    ],
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Listen for Xdebug (wplokerbjm Theme)",
        "type": "php",
        "request": "launch",
        "port": 9004,
        "pathMappings": {
          "/var/www/html/": "${workspaceFolder:wplokerbjm-root}/wordpress/",
        },
      },
    ],
  },
  "tasks": {
    "version": "2.0.0",
    "presentation": {
      "reveal": "never",
      "panel": "new",
    },
    "tasks": [
      {
        "label": "opencode",
        "type": "shell",
        "command": "opencode serve",
        "group": "none",
        "options": {
          "cwd": "${workspaceFolder:wplokerbjm-root}",
        },
        "problemMatcher": [],
      },
      {
        "label": "php-lint",
        "type": "shell",
        "command": "composer run lint:php",
        "group": "test",
        "options": {
          "cwd": "${workspaceFolder:wplokerbjm-backend}",
        },
        "problemMatcher": [],
      },
      {
        "label": "php-composer-autoload",
        "type": "shell",
        "command": "composer run watch:autoload",
        "group": "build",
        "options": {
          "cwd": "${workspaceFolder:wplokerbjm-backend}",
        },
        "problemMatcher": [],
      },
      {
        "label": "php-unit-test",
        "type": "shell",
        "command": "composer run test",
        "group": "test",
        "options": {
          "cwd": "${workspaceFolder:wplokerbjm-backend}",
        },
        "problemMatcher": [],
      },
      {
        "label": "sveltekit:dev",
        "type": "shell",
        "command": "bun run dev",
        "group": "build",
        "options": {
          "cwd": "${workspaceFolder:wplokerbjm-frontend}",
        },
        "problemMatcher": [],
      },
      {
        "label": "sveltekit:build",
        "type": "shell",
        "command": "bun run build",
        "group": "build",
        "options": {
          "cwd": "${workspaceFolder:wplokerbjm-frontend}",
        },
        "problemMatcher": [],
      },
      {
        "label": "sveltekit:preview",
        "type": "shell",
        "command": "bun run preview",
        "group": "build",
        "options": {
          "cwd": "${workspaceFolder:wplokerbjm-frontend}",
        },
        "problemMatcher": [],
      },
      {
        "label": "sveltekit:prepare",
        "type": "shell",
        "command": "bun run prepare",
        "group": "build",
        "options": {
          "cwd": "${workspaceFolder:wplokerbjm-frontend}",
        },
        "problemMatcher": [],
      },
      {
        "label": "sveltekit:check",
        "type": "shell",
        "command": "bun run check",
        "group": "test",
        "options": {
          "cwd": "${workspaceFolder:wplokerbjm-frontend}",
        },
        "problemMatcher": [],
      },
      {
        "label": "sveltekit:check:watch",
        "type": "shell",
        "command": "bun run check:watch",
        "group": "test",
        "options": {
          "cwd": "${workspaceFolder:wplokerbjm-frontend}",
        },
        "problemMatcher": [],
      },
      {
        "label": "sveltekit:lint",
        "type": "shell",
        "command": "bun run lint",
        "group": "test",
        "options": {
          "cwd": "${workspaceFolder:wplokerbjm-frontend}",
        },
        "problemMatcher": [],
      },
    ],
  },
}
