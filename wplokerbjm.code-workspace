{
  "folders": [
    {
      "name": "wplokerbjm-root",
      "path": ".",
    },
    {
      "name": "wplokerbjm-frontend",
      "path": "sveltekit",
    },
    {
      "name": "wplokerbjm-backend",
      "path": "wordpress/wp-content/themes/wplokerbjm",
    },
    {
      "name": "wplokerbjm-post-automation",
      "path": "wplokerbjm-post-automation",
    },
  ],
  "settings": {
    "php.version": "8.5",
    "php.format.rules.addCommaAfterLastArrayElement": true,
    "caddyfile.executable": "${workspaceFolder:wplokerbjm-root}/Caddyfile",
    "editor.codeLens": true,
    "files.watcherExclude": {
      "**/dist": true,
      "**/build": true,
      "**/uploads": true,
      "**/cache": true,
      "**/.svelte-kit": true,
      "**/.git": true,
      "**/node_modules/**": true,
      "**/vendor": true,
      "**/.wrangler": true,
    },
    "[svelte]": {
      "editor.defaultFormatter": "svelte.svelte-vscode",
    },
    "files.associations": {
      "*.css": "tailwindcss",
    },
    "editor.quickSuggestions": {
      "other": "on",
      "comments": "on",
      "strings": "on",
    },
    "eslint.options": {
      "overrideConfigFile": "eslint.config.ts",
    },
    "eslint.workingDirectories": ["${workspaceFolder:wplokerbjm-frontend}"],
    "php.stubs": ["all"],
    "[php]": {
      "editor.defaultFormatter": "DEVSENSE.phptools-vscode",
    },
    "editor.fontFamily": "'Cascadia Code NF'",
    "editor.fontSize": 14,
    "debug.console.fontSize": 12,
    "scm.inputFontSize": 12,
    "terminal.integrated.fontSize": 13,
    "js/ts.tsdk.path": "wplokerbjm-frontend/node_modules/typescript/lib",
    "typescript.enablePromptUseWorkspaceTsdk": true,
    "js/ts.experimental.useTsgo": true,
    "graphql-config.load.rootDir": "sveltekit",
    "js/ts.implicitProjectConfig.target": "ESNext",
    "js/ts.tsserver.node.path": "/usr/bin/node",
    "js/ts.tsserver.maxMemory": 16392,
    "css.enabledLanguages": ["html", "typescript", "javascript", "svelte"],
    "python.analysis.enableParallelIndexing": true,
    "python.analysis.inlayHints.functionReturnTypes": true,
    "python.analysis.inlayHints.pytestParameters": true,
    "python.analysis.inlayHints.variableTypes": true,
    "python.analysis.referencesCodeLens": true,
    "python.analysis.typeEvaluation.enableReachabilityAnalysis": true,
    "python.analysis.typeEvaluation.strictDictionaryInference": true,
    "python.analysis.typeEvaluation.strictListInference": true,
    "python.analysis.typeEvaluation.strictSetInference": true,
    "intelephense.codeLens.overrides.enable": true,
    "intelephense.codeLens.implementations.enable": true,
    "intelephense.codeLens.parent.enable": true,
    "intelephense.codeLens.references.enable": true,
    "intelephense.codeLens.usages.enable": true,
    "intelephense.compatibility.preferPsalmPhpstanPrefixedAnnotations": true,
    "intelephense.completion.fullyQualifyGlobalConstantsAndFunctions": true,
    "intelephense.completion.maxItems": 1000,
    "intelephense.diagnostics.strictTypes": true,
    "typescript.tsdk": "wplokerbjm-frontend/node_modules/typescript/lib",
  },
  "extensions": {
    "recommendations": [
      "DEVSENSE.phptools-vscode",
      "bradlc.vscode-tailwindcss",
      "matthewpi.caddyfile-support",
      "aaron-bond.better-comments",
      "dbaeumer.vscode-eslint",
      "devsense.composer-php-vscode",
      "docker.docker",
      "ms-azuretools.vscode-docker",
      "esbenp.prettier-vscode",
      "ms-vscode.vscode-typescript-next",
      "svelte.svelte-vscode",
    ],
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Listen for Xdebug (wplokerbjm Theme)",
        "type": "php",
        "request": "launch",
        "port": 9004,
        "pathMappings": {
          "/var/www/html/": "${workspaceFolder:wplokerbjm-root}/wordpress/",
        },
      },
    ],
  },
  "tasks": {
    "version": "2.0.0",
    "presentation": {
      "reveal": "never",
      "panel": "new",
    },
    "tasks": [
      {
        "label": "php-lint",
        "type": "shell",
        "command": "composer run lint:php",
        "group": "test",
        "options": {
          "cwd": "${workspaceFolder:wplokerbjm-backend}",
        },
        "problemMatcher": [],
      },
      {
        "label": "php-composer-autoload",
        "type": "shell",
        "command": "composer run watch:autoload",
        "group": "build",
        "options": {
          "cwd": "${workspaceFolder:wplokerbjm-backend}",
        },
        "problemMatcher": [],
      },
      {
        "label": "php-unit-test",
        "type": "shell",
        "command": "composer run test",
        "group": "test",
        "options": {
          "cwd": "${workspaceFolder:wplokerbjm-backend}",
        },
        "problemMatcher": [],
      },
      {
        "label": "sveltekit:dev",
        "type": "shell",
        "command": "bun run dev",
        "group": "build",
        "options": {
          "cwd": "${workspaceFolder:wplokerbjm-frontend}",
        },
        "problemMatcher": [],
      },
      {
        "label": "sveltekit:build",
        "type": "shell",
        "command": "bun run build",
        "group": "build",
        "options": {
          "cwd": "${workspaceFolder:wplokerbjm-frontend}",
        },
        "problemMatcher": [],
      },
      {
        "label": "sveltekit:preview",
        "type": "shell",
        "command": "bun run preview",
        "group": "build",
        "options": {
          "cwd": "${workspaceFolder:wplokerbjm-frontend}",
        },
        "problemMatcher": [],
      },
      {
        "label": "sveltekit:prepare",
        "type": "shell",
        "command": "bun run prepare",
        "group": "build",
        "options": {
          "cwd": "${workspaceFolder:wplokerbjm-frontend}",
        },
        "problemMatcher": [],
      },
      {
        "label": "sveltekit:check",
        "type": "shell",
        "command": "bun run check",
        "group": "test",
        "options": {
          "cwd": "${workspaceFolder:wplokerbjm-frontend}",
        },
        "problemMatcher": [],
      },
      {
        "label": "sveltekit:check:watch",
        "type": "shell",
        "command": "bun run check:watch",
        "group": "test",
        "options": {
          "cwd": "${workspaceFolder:wplokerbjm-frontend}",
        },
        "problemMatcher": [],
      },
      {
        "label": "sveltekit:lint",
        "type": "shell",
        "command": "bun run lint",
        "group": "test",
        "options": {
          "cwd": "${workspaceFolder:wplokerbjm-frontend}",
        },
        "problemMatcher": [],
      },
    ],
  },
}
