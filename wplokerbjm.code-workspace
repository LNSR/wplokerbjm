{
  "folders": [
    {
      "name": "wplokerbjm-root",
      "path": "."
    },
    {
      "name": "wplokerbjm-wp-theme",
      "path": "wordpress/wp-content/themes/wplokerbjm"
    }
  ],
  "settings": {
    "php.version": "8.5",
    "php.format.rules.addCommaAfterLastArrayElement": true,
    "caddyfile.executable": "${workspaceFolder:wplokerbjm}/Caddyfile",
    "editor.codeLens": true,
    "files.watcherExclude": {
      "**/.git": true,
      "**/dist": true,
      "**/build": true,
      "**/uploads": true,
      "**/cache": true
    },
    "[svelte]": {
      "editor.defaultFormatter": "svelte.svelte-vscode"
    },
    "files.associations": {
      "*.css": "tailwindcss"
    },
    "editor.quickSuggestions": {
      "other": "on",
      "comments": "on",
      "strings": "on"
    },
    "eslint.options": {
      "overrideConfigFile": "eslint.config.js"
    },
    "eslint.workingDirectories": ["${workspaceFolder:wplokerbjm-wp-theme}"],
    "php.stubs": ["all"],
    "[php]": {
      "editor.defaultFormatter": "DEVSENSE.phptools-vscode"
    },
    "editor.fontFamily": "'Cascadia Code NF'",
    "editor.fontSize": 14,
    "debug.console.fontSize": 12,
    "scm.inputFontSize": 12,
    "terminal.integrated.fontSize": 13
  },
  "extensions": {
    "recommendations": [
      "DEVSENSE.phptools-vscode",
      "bradlc.vscode-tailwindcss",
      "matthewpi.caddyfile-support",
      "aaron-bond.better-comments",
      "dbaeumer.vscode-eslint",
      "devsense.composer-php-vscode",
      "docker.docker",
      "ms-azuretools.vscode-docker",
      "esbenp.prettier-vscode",
      "ms-vscode.vscode-typescript-next",
      "svelte.svelte-vscode"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Listen for Xdebug (wplokerbjm Theme)",
        "type": "php",
        "request": "launch",
        "port": 9004,
        "pathMappings": {
          "/var/www/html/": "${workspaceFolder:wplokerbjm-root}/wordpress/"
        }
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "php-lint",
        "type": "shell",
        "command": "composer run lint:php",
        "group": "test",
        "options": {
          "cwd": "${workspaceFolder:wplokerbjm-wp-theme}"
        },
        "problemMatcher": []
      },
      {
        "label": "php-composer-autoload",
        "type": "shell",
        "command": "composer run watch:autoload",
        "group": "build",
        "options": {
          "cwd": "${workspaceFolder:wplokerbjm-wp-theme}"
        },
        "problemMatcher": []
      },
      {
        "label": "php-unit-test",
        "type": "shell",
        "command": "composer run test",
        "group": "test",
        "options": {
          "cwd": "${workspaceFolder:wplokerbjm-wp-theme}"
        },
        "problemMatcher": []
      },
      {
        "label": "dev",
        "type": "shell",
        "command": "bun -b run dev --host",
        "group": "build",
        "options": {
          "cwd": "${workspaceFolder:wplokerbjm-wp-theme}"
        },
        "problemMatcher": []
      },
      {
        "label": "build",
        "type": "shell",
        "command": "bun -b run build",
        "group": "build",
        "options": {
          "cwd": "${workspaceFolder:wplokerbjm-wp-theme}"
        },
        "problemMatcher": []
      },
      {
        "label": "check",
        "type": "shell",
        "command": "bun -b run check",
        "group": "test",
        "options": {
          "cwd": "${workspaceFolder:wplokerbjm-wp-theme}"
        },
        "problemMatcher": []
      }
    ]
  }
}
