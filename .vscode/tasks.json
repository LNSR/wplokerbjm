{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev",
      "type": "shell",
      "command": "bun run dev",
      "group": "build",
      "options": {
        "cwd": "${workspaceFolder:astra-child}"
      },
      "problemMatcher": []
    },
    {
      "label": "build",
      "type": "shell",
      "command": "bun run build",
      "group": "build",
      "options": {
        "cwd": "${workspaceFolder:astra-child}"
      },
      "problemMatcher": []
    },
    {
      "label": "lint",
      "type": "shell",
      "command": "bun run lint",
      "group": "test",
      "options": {
        "cwd": "${workspaceFolder:astra-child}"
      },
      "problemMatcher": []
    },
    {
      "label": "php-lint",
      "type": "shell",
      "command": "composer run lint:php",
      "group": "test",
      "options": {
        "cwd": "${workspaceFolder:astra-child}"
      },
      "problemMatcher": []
    }
  ]
}
