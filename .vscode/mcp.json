{
  "servers": {
    "playwright": {
      "command": "bunx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--ignore-https-errors",
        "--browser=chrome-beta",
        "--isolated"
      ],
      "type": "stdio"
    },
    "sequentialthinking": {
      "type": "http",
      "url": "https://remote.mcpservers.org/sequentialthinking/mcp"
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${env:CONTEXT7_API_KEY}"
      }
    },
    "memory": {
      "command": "bunx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "type": "stdio"
    },
    "redis": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--network",
        "host",
        "--env-file",
        "${workspaceFolder}/.env",
        "-v",
        "${workspaceFolder}/mcp/redis:${workspaceFolder}",
        "mcp/redis"
      ],
      "type": "stdio"
    },
    "mysql": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--network",
        "host",
        "--env-file",
        "${workspaceFolder}/.env",
        "-v",
        "${workspaceFolder}/mcp/mysql:${workspaceFolder}",
        "docker.io/acuvity/mcp-server-benborla-mysql:latest"
      ],
      "type": "stdio"
    }
  }
}
