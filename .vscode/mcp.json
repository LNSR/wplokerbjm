{
  "servers": {
    "playwright": {
      "command": "bunx",
      "args": [
        "--bun",
        "-y",
        "@playwright/mcp@latest",
        "--ignore-https-errors",
        "--browser=chrome",
        "--shared-browser-context",
        "--extension"
      ],
      "env": {
        "PLAYWRIGHT_MCP_EXTENSION_TOKEN": "${env:PLAYWRIGHT_MCP_EXTENSION_TOKEN}"
      },
      "type": "stdio"
    },
    "chrome-devtools": {
      "command": "bunx",
      "args": ["--bun", "-y", "chrome-devtools-mcp@latest"]
    },
    "motion": {
      "command": "bunx",
      "args": ["--bun", "-y", "motion-ai"]
    },
    "svelte": {
      "type": "http",
      "url": "https://mcp.svelte.dev/mcp"
    },
    "sequentialthinking": {
      "type": "http",
      "url": "https://remote.mcpservers.org/sequentialthinking/mcp"
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${input:CONTEXT7_API_KEY}"
      }
    },
    "memory": {
      "command": "bunx",
      "args": ["--bun", "-y", "@modelcontextprotocol/server-memory"],
      "type": "stdio"
    },
    "redis": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--network",
        "host",
        "--env-file",
        "${workspaceFolder}/.env",
        "mcp/redis"
      ],
      "type": "stdio"
    },
    "mysql": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--network",
        "host",
        "--env-file",
        "${workspaceFolder}/.env",
        "docker.io/acuvity/mcp-server-benborla-mysql:latest"
      ],
      "type": "stdio"
    },
    "wplokerbjm-royalmcp-production": {
      "type": "http",
      "url": "https://wp.lokerbanjarmasin.my.id/wp-json/royal-mcp/v1/mcp",
      "headers": {
        "X-Royal-MCP-API-Key": "${input:X_ROYAL_MCP_API_KEY}"
      },
    },
  },
  "inputs": [
    {
      "id": "X_ROYAL_MCP_API_KEY",
      "type": "promptString",
      "description": "API key for Royal MCP"
    },
    {
      "id": "CONTEXT7_API_KEY",
      "type": "promptString",
      "description": "API key for Context7"
    }
  ]
}
