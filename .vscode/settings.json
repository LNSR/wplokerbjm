{
  "editor.formatOnSave": true,
  // "intelephense.environment.includePaths": [
  //   "${workspaceFolder:wplokerbjm}/vendor/php-stubs",
  //   "${workspaceFolder:wplokerbjm}/vendor"
  // ],
  "intelephense.environment.includePaths": [
    "${workspaceFolder:wplokerbjm-svelte/vendor/php-stubs",
    "${workspaceFolder:wplokerbjm-svelte/vendor"
  ],
  "intelephense.files.exclude": ["**/vendor/**", "**/node_modules/**"],
  "editor.codeLens": true,
  "files.watcherExclude": {
    "**/node_modules": true,
    "**/vendor": true,
    "**/.git": true,
    "**/dist": true,
    "**/build": true,
    "**/uploads": true,
    "**/cache": true
  },
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "on",
    "strings": "on"
  },
  "caddyfile.executable": "${workspaceFolder:wplokerbjm}/Caddyfile"
}
