{
  "editor.formatOnSave": true,
  "intelephense.environment.includePaths": [
    "${workspaceFolder:astra-child}/vendor/php-stubs",
    "${workspaceFolder:astra-child}/vendor"
  ],
  "editor.codeLens": true,
  "files.watcherExclude": {
    "**/node_modules": true,
    "**/vendor": true,
    "**/.git": true,
    "**/dist": true,
    "**/build": true,
    "**/uploads": true,
    "**/cache": true
  },
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "on",
    "strings": "on"
  },
  "tailwindCSS.includeLanguages": {
    "vue": "vue",
    "php": "php"
  },
  "caddyfile.executable": "${workspaceFolder:wplokerbjm}/Caddyfile"
}
