# Ignore the contents of wordpress, but allow Git to scan the folder itself
wordpress/*

# Re-include the specific paths with trailing slashes so Git can crawl down them
!wordpress/wp-content/
wordpress/wp-content/*

!wordpress/wp-content/mu-plugins/
wordpress/wp-content/mu-plugins/*
!wordpress/wp-content/mu-plugins/wplokerbjm-bootstrap.php

!wordpress/wp-content/themes/
wordpress/wp-content/themes/*
!wordpress/wp-content/themes/wplokerbjm/
