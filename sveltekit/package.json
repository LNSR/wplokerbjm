{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "wplokerbjm-sveltekit",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "sideEffects": false,
  "packageManager": "bun",
  "scripts": {
    "bun:config": "bun --use-system-ca --env-file=.env",
    "dev": "bun run bun:config --bun vite dev --host > log/vite.dev.log 2>&1",
    "build": "bun run bun:config --bun vite build > log/vite.build.log 2>&1",
    "ci:deploy": "bun run bun:config --bun vite build",
    "preview": "bun run bun:config wrangler dev > log/vite.preview.log 2>&1",
    "prepare": "bun run bun:config --parallel \"ts-patch install\" \"svelte-kit sync || echo ''\"",
    "check": "bun run bun:config --bun --parallel \"svelte-check-rs --tsconfig ./tsconfig.json\" \"tsgo\"",
    "check:watch": "bun run bun:config --parallel \"svelte-check-rs --tsconfig ./tsconfig.json --watch\"",
    "generate-types": "bun run bun:config --parallel \"wrangler types\" \"gql-tada generate-output --output './src/graphql-env.d.ts'\" \"gql-tada generate turbo\""
  },
  "graphql": {
    "schema": "https://localhost/graphql",
    "documents": "**/*.{graphql,ts,svelte}"
  },
  "dependencies": {
    "@qwik.dev/partytown": "^0.14.0",
    "comlink": "^4.4.2",
    "idb": "^8.0.3",
    "lru-cache": "^11.5.2",
    "swiper": "^14.1.0",
    "urql": "^5.0.3",
    "viewerjs": "^1.11.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260808.1",
    "@eslint/compat": "^2.1.0",
    "@gql.tada/svelte-support": "^1.0.3",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.2",
    "@tailwindcss/vite": "4.3.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typia/unplugin": "^12.1.1",
    "@urql/exchange-persisted": "^5.0.1",
    "daisyui": "^5.7.16",
    "es-toolkit": "^1.50.0",
    "eslint": "^10.8.1",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.9.0",
    "gql.tada": "^1.11.3",
    "graphql": "^17.0.2",
    "runed": "^0.37.1",
    "svelte": "^5.56.8",
    "svelte-awesome-icons": "^3.0.1",
    "svelte-check": "^4.7.5",
    "svelte-check-rs": "^0.10.2",
    "sveltekit-device-detector": "^2.0.1",
    "tailwindcss": "4.3.2",
    "ts-patch": "^4.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0",
    "typia": "^12.1.1",
    "vite": "^8.2.1",
    "vite-bundle-analyzer": "^1.3.9",
    "vite-plugin-devtools-json": "^1.1.0",
    "wrangler": "^4.120.0"
  },
  "overrides": {
    "ts-patch": "^4.0.1",
    "typescript": "^6.0.3",
    "@typia/unplugin": "^12.1.1",
    "typia": "^12.1.1"
  }
}
