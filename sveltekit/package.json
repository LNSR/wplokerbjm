{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "wplokerbjm-sveltekit",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "sideEffects": false,
  "packageManager": "bun",
  "scripts": {
    "bun:config": "bun --use-system-ca --env-file=.env",
    "dev": "bun run bun:config --bun vite dev --host > log/vite.dev.log 2>&1",
    "build": "bun run bun:config --bun vite build > log/vite.build.log 2>&1",
    "ci:deploy": "CLOUDFLARE_ENV=production bun run bun:config --bun vite build",
    "preview": "bun run bun:config wrangler dev > log/vite.preview.log 2>&1",
    "prepare": "bun run bun:config --parallel \"ts-patch install\" \"svelte-kit sync || echo ''\"",
    "check": "bun run bun:config --bun --parallel \"svelte-check --tsconfig ./tsconfig.json\" \"tsc --noEmit\"",
    "check:watch": "bun run bun:config --parallel \"svelte-check --tsconfig ./tsconfig.json --watch\"",
    "generate-types": "bun run bun:config --parallel \"wrangler types\" \"gql-tada generate-output --output './src/graphql-env.d.ts'\" \"gql-tada generate turbo\""
  },
  "graphql": {
    "schema": "https://localhost/graphql",
    "documents": "**/*.{graphql,ts,svelte}"
  },
  "dependencies": {
    "@qwik.dev/partytown": "^1.0.5",
    "comlink": "^4.4.2",
    "idb": "^8.0.4",
    "lru-cache": "^11.5.3",
    "swiper": "^14.4.0",
    "urql": "^5.0.4",
    "viewerjs": "^1.15.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261124.1",
    "@eslint/compat": "^2.1.1",
    "@gql.tada/svelte-support": "^1.0.3",
    "@sveltejs/adapter-cloudflare": "^9.0.0",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@tailwindcss/vite": "4.3.3",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typia/unplugin": "^12.1.1",
    "@urql/exchange-persisted": "^5.0.1",
    "daisyui": "^5.8.2",
    "es-toolkit": "^1.53.2",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "gql.tada": "^1.11.5",
    "graphql": "^17.1.0",
    "runed": "^0.38.0",
    "svelte": "^5.59.1",
    "svelte-awesome-icons": "^3.1.1",
    "svelte-check": "^4.7.8",
    "svelte-check-rs": "^0.11.2",
    "sveltekit-device-detector": "^2.0.1",
    "tailwindcss": "4.3.5",
    "ts-patch": "^4.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "typia": "^12.2.1",
    "vite": "^8.3.8",
    "vite-bundle-analyzer": "^1.3.9",
    "vite-plugin-devtools-json": "^1.1.2",
    "wrangler": "^4.167.0"
  },
  "overrides": {
    "ts-patch": "^4.0.1",
    "typescript": "^6.0.3",
    "@typia/unplugin": "^12.1.1",
    "typia": "^12.1.1"
  },
  "imports": {
    "#lib/*": "./src/lib/*",
    "#src/*": "./src/*"
  }
}
