{
  storage redis {
        host           "redis"
        port           6379
        password       "{env.REDIS_PWD}"
        db             0
        key_prefix     "caddy"
        compression    true
        tls_enabled    false
        tls_insecure   true
    }
}


:443 {
  tls /var/www/certs/localhost.crt /var/www/certs/localhost.key # ! Use your own certificate
  root * /var/www/html
  # WordPress: try existing file, then directory, otherwise fall back to index.php
  # This enables pretty permalinks to be handled by WordPress.
  try_files {path} {path}/ /index.php?{query}
  # Pass request host/proto headers into PHP-FPM so PHP's $_SERVER sees
  # HTTP_X_FORWARDED_HOST and HTTP_X_FORWARDED_PROTO when using AUTO mode.
  # This preserves the original host/proto coming from the client/proxy
  # and allows WordPress to choose the correct siteurl/home dynamically.
  php_fastcgi wordpress:9000 {
    env HTTP_X_FORWARDED_PROTO {scheme}
    env HTTP_X_FORWARDED_HOST {host}
    env HTTP_HOST {host}
  }

  # * Rewrite /node_modules/* to the {your-theme} node_modules directory
  # * Use this to serve local node_modules for development purposes
  # * This assumes the node_modules directory is located at /var/www/html/wp-content/themes/{your-theme}/node_modules
  @node_modules_path path_regexp node_modules ^/node_modules/(.*)$
  rewrite @node_modules_path /wp-content/themes/wplokerbjm/node_modules/{re.node_modules.1}

  file_server {
    precompressed
  }

  @production expression {env.WP_ENV} == "production"
  encode @production {
    zstd best
  }

  @static path /wp-content/* /wp-includes/* /favicon.ico /robots.txt
  @dynamic not path /wp-content/* /wp-includes/* /favicon.ico /robots.txt

  # Default security headers
  header {
    Access-Control-Allow-Origin *
    Access-Control-Allow-Methods "GET, POST, OPTIONS, PUT, DELETE"
    Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Authorization, X-WP-Nonce, Content-Disposition, Content-MD5"
    Access-Control-Expose-Headers "X-WP-Total, X-WP-TotalPages, Link, X-WP-Nonce"
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    X-XSS-Protection "1; mode=block"
    Permissions-Policy "geolocation=(), microphone=(), camera=()"
    -X-Powered-By
  }

  # Cache static assets long-term, prevent caching dynamic content
  header @static Cache-Control "public, max-age=31536000, immutable"
  header @static Expires "Thu, 31 Dec 2037 23:55:55 GMT"

  header @dynamic Cache-Control "no-cache, no-store, must-revalidate"
  header @dynamic Pragma "no-cache"
  header @dynamic Expires "0"

  replace "https://localhost" "https://{host}"

  log {
    output stdout
    format console
  }
}

:80 {
  redir https://{host}{uri} permanent
}