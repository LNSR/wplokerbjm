:443 {
  tls /var/www/certs/localhost.crt /var/www/certs/localhost.key # ! Use your own certificate
  @production expression {env.WP_ENV} == "production"
  @development expression {env.WP_ENV} == "development"

  @partytown_dev path_regexp partytownDev ^/~partytown(/.*)?$
  header @partytown_dev Service-Worker-Allowed "/"

  @partytown_assets path_regexp partytownAssets ^/wp-content/themes/wplokerbjm/assets/dist/~partytown(/.*)?$
  header @partytown_assets Service-Worker-Allowed "/"

  @partytown_sw path_regexp partytownSW ^/wp-content/themes/wplokerbjm/assets/dist/~partytown/.*partytown-sw.*$
  header @partytown_sw Cache-Control "no-cache, no-store, must-revalidate"
  header @partytown_sw Pragma "no-cache"
  header @partytown_sw Expires "0"

  root * /var/www/html
  # Pass request host/proto headers into PHP-FPM so PHP's $_SERVER sees
  # HTTP_X_FORWARDED_HOST and HTTP_X_FORWARDED_PROTO when using AUTO mode.
  # This preserves the original host/proto coming from the client/proxy
  # and allows WordPress to choose the correct siteurl/home dynamically.
  php_fastcgi unix//var/run/sock/php-fpm.sock {
    env HTTP_X_FORWARDED_PROTO {scheme}
    env HTTP_X_FORWARDED_HOST {host}
    env HTTP_HOST {host}
    env HTTP_X_FORWARDED_FOR {remote}
    env HTTP_X_REAL_IP {remote_host}
  }

  file_server {
    precompressed br
  }

  encode @production {
    zstd best
  }

  # Matchers: static file extensions, fonts, wp static paths and special endpoints
  @static_ext path_regexp staticExt ^/.*\.(css|js|json|xml|pdf|txt|ico|jpg|jpeg|png|webp|avif|svg|htc|ttf|woff|woff2|eot|otf|html)$
  @wp_static path /wp-content/* /wp-includes/* /favicon.ico /robots.txt
  @no_cache path /wp-login.php /wp-admin/* /xmlrpc.php /wp-comments-post.php /wp-cron.php /__vite/*
  @rest_api path ^/wp-json(/.*)?$
  @graphql path_regexp graphql ^/graphql(/.*)?$
  @dynamic not path /wp-content/* /wp-includes/* /favicon.ico /robots.txt /wp-admin/* /wp-login.php /wp-json/* /xmlrpc.php /wp-cron.php
  @logged_in header_regexp Cookie wordpress_logged_in_.*

  # Default security headers for all responses (keeps site secure while remaining permissive for WordPress plugins)
   header {
    Content-Security-Policy "Upgrade-Insecure-Requests"
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Permissions-Policy "microphone=(), camera=(), payment=()"
    Cross-Origin-Embedder-Policy "credentialless"
    Cross-Origin-Opener-Policy "same-origin"
    -X-Powered-By
    X-Real-IP {remote_host}
  }

  header {
    X-Not-Modified "true"
    match status 304
  }

  # Static assets: long-term caching and immutable flag (fingerprinted assets) + caching for CDNs
  header @production @static_ext Cache-Control "public, max-age=31536000, immutable, s-maxage=31536000, stale-while-revalidate=2592000, stale-if-error=604800"
  header @production @static_ext Expires "Thu, 31 Dec 2037 23:55:55 GMT"
  header @production @static_ext Vary "Accept-Encoding, Cookie"
  header @production @static_ext "Last-Modified" {file.modtime}
  header @production @static_ext Access-Control-Allow-Origin "*"  # Added: ensures CORS for fonts and other assets if needed

  header @development @static_ext Cache-Control "public, max-age=3600, stale-while-revalidate=1800"
  header @development @static_ext Expires "Thu, 31 Dec 2036 23:55:55 GMT"
  header @development @static_ext Vary "Accept-Encoding, Cookie"
  header @development @static_ext "Last-Modified" {file.modtime}
  header @development @static_ext Access-Control-Allow-Origin "*"

  # wp-content paths (plugins, themes) - long-term caching for static assets, shorter for potentially dynamic files
  header @production @wp_static not @static_ext Cache-Control "public, max-age=86400, s-maxage=86400, stale-while-revalidate=2592000, stale-if-error=604800"
  header @production @wp_static not @static_ext Expires "Thu, 31 Dec 2036 23:55:55 GMT"
  header @production @wp_static not @static_ext Vary "Accept-Encoding"
  header @production @wp_static not @static_ext "Last-Modified" {file.modtime}
  header @production @wp_static not @static_ext Access-Control-Allow-Origin "*"

  header @development @wp_static not @static_ext Cache-Control "public, max-age=1800, stale-while-revalidate=1800, stale-if-error=3600"
  header @development @wp_static not @static_ext Expires "Thu, 31 Dec 2036 23:55:55 GMT"
  header @development @wp_static not @static_ext Vary "Accept-Encoding"
  header @development @wp_static not @static_ext "Last-Modified" {file.modtime}
  header @development @wp_static not @static_ext Access-Control-Allow-Origin "*"

  # GraphQL API: private cache for logged-in users, public cache with background revalidation for anonymous
  header @production @graphql @logged_in Cache-Control "private, max-age=300, stale-while-revalidate=600, stale-if-error=3600"
  header @production @graphql not @logged_in Cache-Control "public, max-age=3600, s-maxage=7200, stale-while-revalidate=7200, stale-if-error=86400"
  header @production @graphql not @logged_in Vary "Accept-Encoding, Cookie"
  header @development @graphql Cache-Control "private, max-age=60, stale-while-revalidate=120"

  # REST API: private cache for logged-in users, long public cache with background revalidation for anonymous
  header @production @rest_api @logged_in Cache-Control "private, max-age=300, stale-while-revalidate=600, stale-if-error=3600"
  header @production @rest_api not @logged_in Cache-Control "public, max-age=3600, s-maxage=7200, stale-while-revalidate=7200, stale-if-error=86400"
  header @production @rest_api not @logged_in Vary "Accept-Encoding, Cookie"
  header @development @rest_api Cache-Control "private, max-age=60, stale-while-revalidate=120"

  # Privileged paths (wp-login.php, admin, xmlrpc, cron): allow private browser cache only
  header @no_cache Cache-Control "no-cache, must-revalidate, no-store, max-age=0, private"

  # Dynamic content (pages) — private cache for logged-in users, public cache for anonymous
  header @production @dynamic @logged_in Cache-Control "private, max-age=360"
  header @production @dynamic not @logged_in Cache-Control "public, max-age=600, s-maxage=1200, stale-while-revalidate=1200, stale-if-error=86400"
  header @production @dynamic not @logged_in Vary "Accept-Encoding, Cookie"

  replace "https://localhost" "https://{host}"

  log {
    output stdout
    format console
  }
}

:80 {
  redir https://{host}{uri} permanent
}