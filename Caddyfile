:443 {
  tls /var/www/certs/localhost.crt /var/www/certs/localhost.key # Use your own certificate
  root * /var/www/html
  # WordPress: try existing file, then directory, otherwise fall back to index.php
  # This enables pretty permalinks to be handled by WordPress.
  try_files {path} {path}/ /index.php?{query}
  php_fastcgi wordpress:9000

  # Rewrite /node_modules/* to the {your-theme} node_modules directory
  # Use this to serve local node_modules for development purposes
  # This assumes the node_modules directory is located at /var/www/html/wp-content/themes/{your-theme}/node_modules
  @node_modules_path path_regexp node_modules ^/node_modules/(.*)$
  rewrite @node_modules_path /wp-content/themes/astra-child/node_modules/{re.node_modules.1}

  file_server {
    precompressed
  }

  encode {
    zstd best
  }

  # Default security headers
  header {
    Access-Control-Allow-Origin *
    Access-Control-Allow-Methods "GET, POST, OPTIONS, PUT, DELETE"
    Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Authorization"
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    X-XSS-Protection "1; mode=block"
    Permissions-Policy "geolocation=(), microphone=(), camera=()"
  }

  # Aggressive cache for static assets
  @static_assets {
    path_regexp static_assets ".*\.(?:js|css|png|jpg|jpeg|gif|svg|webp|ico|woff2?|ttf|eot|otf|mp4|webm|ogg|mp3|json|xml|map)$"
  }
  header @static_assets {
    Cache-Control "public, max-age=31536000, immutable"
    Expires "Thu, 31 Dec 2037 23:55:55 GMT"
    Pragma "cache"
  }

  # No cache for HTML/PHP (dynamic content)
  @dynamic_content {
    path_regexp dynamic_content ".*\.(?:php|html?)$"
  }
  header @dynamic_content {
    Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Pragma "no-cache"
    Expires "0"
  }

  log {
    output stdout
    format console
  }
}

:80 {
  redir https://{host}{uri} permanent
}