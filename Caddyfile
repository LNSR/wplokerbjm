:443 {
  tls /var/www/certs/localhost.crt /var/www/certs/localhost.key # ! Use your own certificate

  @vite path_regexp vite ^/(__vite|@vite|@id|@fs|sockjs-node)(/.*)?$
  handle @vite {
    # Proxy Vite dev endpoints. Tuned for HMR (websockets) and dev performance.
    # If you run multiple Vite instances for scaling, add them here as additional upstreams.
    reverse_proxy host.docker.internal:5173 {
      # Preserve headers Vite needs for HMR / dev pages
      header_up Origin {http.request.header.Origin}
      header_up Host {http.request.host}
      header_up X-Forwarded-Host {host}
      header_up X-Forwarded-Proto {scheme}
      header_up X-Forwarded-For {remote}
      header_up X-Real-IP {remote_host}
      header_up Upgrade {http.request.header.Upgrade}
      header_up Connection {http.request.header.Connection}

      # Improve HMR/streaming responsiveness
      flush_interval 50ms
      stream_timeout 0
      stream_close_delay 1m
    }
  }

  # * Rewrite /node_modules/* to the Vite node_modules directory
  # * Use this to serve local node_modules for development purposes
  @node_modules_path path_regexp node_modules ^/node_modules/(.*)$
  rewrite @node_modules_path /__vite/node_modules/{re.node_modules.1}

  root * /var/www/html
  # Pass request host/proto headers into PHP-FPM so PHP's $_SERVER sees
  # HTTP_X_FORWARDED_HOST and HTTP_X_FORWARDED_PROTO when using AUTO mode.
  # This preserves the original host/proto coming from the client/proxy
  # and allows WordPress to choose the correct siteurl/home dynamically.
  php_fastcgi unix//var/run/sock/php-fpm.sock {
    env HTTP_X_FORWARDED_PROTO {scheme}
    env HTTP_X_FORWARDED_HOST {host}
    env HTTP_HOST {host}
  }

  file_server {
    precompressed zstd
  }

  @production expression {env.WP_ENV} == "production"
  encode @production {
    zstd best
  }

  # Matchers: static file extensions, fonts, wp static paths and special endpoints
  @static_ext path_regexp staticExt ^/.*\.(css|js|json|xml|pdf|txt|ico|jpg|jpeg|png|webp|avif|svg|htc|ttf|woff|woff2|eot|otf)$
  @fonts path_regexp fonts ^/.*\.(ttf|woff|woff2|eot|otf)$
  @wp_static path /wp-content/* /wp-includes/* /favicon.ico /robots.txt
  @no_cache path /wp-login.php /wp-admin/* /xmlrpc.php /wp-comments-post.php /wp-cron.php /__vite/*
  @rest_api path /wp-json/*
  @dynamic not path /wp-content/* /wp-includes/* /favicon.ico /robots.txt /wp-admin/* /wp-login.php /wp-json/* /xmlrpc.php /wp-cron.php
  @logged_in header_regexp Cookie wordpress_logged_in_.*

  # Default security headers for all responses (keeps site secure while remaining permissive for WordPress plugins)
  header {
    Content-Security-Policy "Upgrade-Insecure-Requests"
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    X-XSS-Protection "1; mode=block"
    Permissions-Policy "geolocation=(), microphone=(), camera=()"
    -X-Powered-By
    X-Real-IP {remote_host}
  }

  header {
    X-Not-Modified "true"
    match status 304
  }

  # Static assets: long-term caching and immutable flag (fingerprinted assets) + caching for CDNs
  header @static_ext Cache-Control "public, max-age=31536000, immutable, s-maxage=31536000, stale-while-revalidate=2592000, stale-if-error=604800"
  header @static_ext Expires "Thu, 31 Dec 2037 23:55:55 GMT"
  header @static_ext Vary "Accept-Encoding, Cookie"
  header @static_ext "Last-Modified" {file.modtime}

  # Fonts: allow cross-origin requests (for @font-face), long cache and CORS so web fonts work across domains
  header @fonts Cache-Control "public, max-age=31536000, immutable, s-maxage=31536000"
  header @fonts Access-Control-Allow-Origin "*"

  # wp-content paths (plugins, themes) - long-term for static assets while still allowing some dynamic files
  header @wp_static Cache-Control "public, max-age=31536000, immutable, s-maxage=31536000, stale-while-revalidate=2592000"
  header @wp_static Expires "Thu, 31 Dec 2037 23:55:55 GMT"
  header @wp_static Vary "Accept-Encoding"

  # REST API: private cache for logged-in users, long public cache with background revalidation for anonymous
  header @rest_api @logged_in Cache-Control "private, max-age=300"
  header @rest_api not @logged_in Cache-Control "public, max-age=3600, s-maxage=7200, stale-while-revalidate=7200, stale-if-error=86400"
  header @rest_api not @logged_in Vary "Accept-Encoding, Cookie"

  # Privileged paths (wp-login.php, admin, xmlrpc, cron): allow private browser cache only
  header @no_cache Cache-Control "private, max-age=360, must-revalidate"

  # Dynamic content (pages) — private cache for logged-in users, public cache for anonymous
  header @dynamic @logged_in Cache-Control "private, max-age=360"
  header @dynamic not @logged_in Cache-Control "public, max-age=600, s-maxage=1200, stale-while-revalidate=1200, stale-if-error=86400"
  header @dynamic not @logged_in Vary "Accept-Encoding, Cookie"

  replace "https://localhost" "https://{host}"
  replace "http://localhost" "http://{host}"

  log {
    output stdout
    format console
  }
}

:80 {
  redir https://{host}{uri} permanent
}